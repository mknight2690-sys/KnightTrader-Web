{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knighttrader.local/schema/muse.telemetry.v1.schema.json",
  "title": "Muse telemetry snapshot v1",
  "description": "Reference for the read-only desktop feed at GET /v1/snapshot and GET /v1/stream. Schema name is muse.telemetry.v1. This file documents the live shape. The page does not validate snapshots against it, and it does not add control or trading endpoints.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "groups"],
  "properties": {
    "schema": { "const": "muse.telemetry.v1" },
    "bot": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "server_ts_ms": { "type": "integer" },
    "server_ts_ny": { "type": "string" },
    "ui_cadence_ms": { "type": "integer", "minimum": 0 },
    "note": { "type": "string" },
    "build_ms": { "type": "integer" },
    "groups": { "$ref": "#/$defs/groups" }
  },
  "$defs": {
    "nullable": {
      "anyOf": [{ "type": "null" }, {}]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "as_of_ms": { "type": "integer" },
        "as_of_ny": { "type": "string" },
        "stale_after_ms": { "type": "integer" },
        "source": { "type": "string" },
        "error": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "age_ms": { "type": "integer" },
        "fresh": { "type": "boolean" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pnl": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "pct": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "cashflow": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "partial": { "type": "boolean" },
        "baseline_label": { "type": "string" },
        "baseline_equity": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "baseline_time_ms": { "anyOf": [{ "type": "null" }, { "type": "integer" }] },
        "error": { "anyOf": [{ "type": "null" }, { "type": "string" }] }
      }
    },
    "closedTrade": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "coin": { "type": "string" },
        "side": { "type": "string" },
        "tf": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "result": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "r": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "entry": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "exit": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "reason": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "ts_ny": { "anyOf": [{ "type": "null" }, { "type": "string" }] }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string" },
        "coin": { "type": "string" },
        "side": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "tf": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "result": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "r": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "entry": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "exit": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "ts_ny": { "anyOf": [{ "type": "null" }, { "type": "string" }] }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "account": {
          "allOf": [
            { "$ref": "#/$defs/envelope" },
            {
              "type": "object",
              "properties": {
                "balance": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
                "baseline": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "equity": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
                    "time_ms": { "anyOf": [{ "type": "null" }, { "type": "integer" }] },
                    "label_ny": { "type": "string" },
                    "requested_ny": { "type": "string" }
                  }
                },
                "periods": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/period" },
                  "properties": {
                    "Today": { "$ref": "#/$defs/period" },
                    "This Week": { "$ref": "#/$defs/period" },
                    "This Month": { "$ref": "#/$defs/period" },
                    "Total": { "$ref": "#/$defs/period" }
                  }
                },
                "ledger_ok": { "type": "boolean" },
                "account_mode": { "type": "string" }
              }
            }
          ]
        },
        "bot_health": { "$ref": "#/$defs/envelope" },
        "trades": {
          "allOf": [
            { "$ref": "#/$defs/envelope" },
            {
              "type": "object",
              "properties": {
                "open": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
                "today_score": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "day": { "type": "string" },
                    "net_r": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
                    "trades": { "anyOf": [{ "type": "null" }, { "type": "integer" }] },
                    "wins": { "anyOf": [{ "type": "null" }, { "type": "integer" }] }
                  }
                },
                "all_time_score": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "net_r": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
                    "trades": { "anyOf": [{ "type": "null" }, { "type": "integer" }] },
                    "wins": { "anyOf": [{ "type": "null" }, { "type": "integer" }] }
                  }
                }
              }
            }
          ]
        },
        "signals": { "$ref": "#/$defs/envelope" },
        "journal": {
          "allOf": [
            { "$ref": "#/$defs/envelope" },
            {
              "type": "object",
              "properties": {
                "closed": { "type": "array", "items": { "$ref": "#/$defs/closedTrade" } },
                "recent_fills": { "type": "array", "items": { "$ref": "#/$defs/fill" } },
                "cashflows": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
              }
            }
          ]
        },
        "market": {
          "allOf": [
            { "$ref": "#/$defs/envelope" },
            {
              "type": "object",
              "properties": {
                "mids": {
                  "type": "object",
                  "additionalProperties": { "anyOf": [{ "type": "null" }, { "type": "number" }, { "type": "string" }] }
                }
              }
            }
          ]
        }
      }
    }
  }
}
